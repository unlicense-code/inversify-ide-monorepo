{
  "name": "@theia/electron",
  "version": "1.66.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "types": "./lib/index.d.ts"
    },
    "./shared/electron": {
      "import": "./lib/shared/electron/index.js",
      "types": "./lib/shared/electron/index.d.ts"
    },
    "./shared/electron-store": {
      "import": "./lib/shared/electron-store/index.js",
      "types": "./lib/shared/electron-store/index.d.ts"
    },
    "./shared/fix-path": {
      "import": "./lib/shared/fix-path/index.js",
      "types": "./lib/shared/fix-path/index.d.ts"
    },
    "./shared/native-keymap": {
      "import": "./lib/shared/native-keymap/index.js",
      "types": "./lib/shared/native-keymap/index.d.ts"
    },
    "./shared/electron/index.js": {
      "import": "./lib/shared/electron/index.js",
      "types": "./lib/shared/electron/index.d.ts"
    },
    "./shared/electron-store/index.js": {
      "import": "./lib/shared/electron-store/index.js",
      "types": "./lib/shared/electron-store/index.d.ts"
    },
    "./shared/fix-path/index.js": {
      "import": "./lib/shared/fix-path/index.js",
      "types": "./lib/shared/fix-path/index.d.ts"
    },
    "./shared/native-keymap/index.js": {
      "import": "./lib/shared/native-keymap/index.js",
      "types": "./lib/shared/native-keymap/index.d.ts"
    }
  },
  "description": "Theia - Electron utility package",
  "dependencies": {
    "electron-store": "^8.0.0",
    "fix-path": "^4.0.0",
    "native-keymap": "^2.2.1"
  },
  "devDependencies": {
    "@theia/ext-scripts": "1.66.0",
    "@theia/re-exports": "1.66.0"
  },
  "peerDependencies": {
    "electron": "38.4.0"
  },
  "theiaReExports": {
    "lib/shared": {
      "export *": [
        "native-keymap"
      ],
      "export =": [
        "electron as Electron",
        "electron-store as ElectronStore"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "theiaExtensions": [],
  "keywords": [
    "theia-extension"
  ],
  "license": "EPL-2.0 OR GPL-2.0-only WITH Classpath-exception-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/eclipse-theia/theia.git"
  },
  "bugs": {
    "url": "https://github.com/eclipse-theia/theia/issues"
  },
  "homepage": "https://github.com/eclipse-theia/theia",
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "theiaext build",
    "clean": "theiaext clean",
    "compile": "theiaext compile",
    "lint": "theiaext lint",
    "test": "theiaext test",
    "watch": "theiaext watch",
    "afterInstall": "npm run generate-theia-re-exports",
    "generate-theia-re-exports": "theia-re-exports generate && theia-re-exports template README_TEMPLATE.md > README.md"
  },
  "nyc": {
    "extends": "../../configs/nyc.json"
  },
  "gitHead": "21358137e41342742707f660b8e222f940a27652"
}
